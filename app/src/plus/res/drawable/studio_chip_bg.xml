<?xml version="1.0" encoding="utf-8"?>
<!-- Search chip: apricot gradient when focused, warm translucent glass otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/studio_peach"
                android:startColor="@color/studio_apricot" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFE7D6" />
            <stroke
                android:width="1dp"
                android:color="#26FFE7D6" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
