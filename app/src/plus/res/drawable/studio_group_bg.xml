<?xml version="1.0" encoding="utf-8"?>
<!-- Tinted per row by StudioGroupCardPresenter; the light top-left sheen gives it some depth -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/studio_group_fill">
        <shape android:shape="rectangle">
            <solid android:color="@color/studio_apricot" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#40FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#1A000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
