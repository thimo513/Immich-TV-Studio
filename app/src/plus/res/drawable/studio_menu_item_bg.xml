<?xml version="1.0" encoding="utf-8"?>
<!-- Menu entry: glowing apricot-to-peach pill when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#40F7B58C" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="@color/studio_peach"
                        android:startColor="@color/studio_apricot" />
                    <corners android:radius="27dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
