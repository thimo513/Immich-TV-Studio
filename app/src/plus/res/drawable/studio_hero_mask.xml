<?xml version="1.0" encoding="utf-8"?>
<!-- Alpha mask of the hero (drawn with DST_IN): the photo melts into the page towards the bottom,
     with no visible edge whatever the page background looks like -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#CC000000"
        android:centerY="0.5"
        android:endColor="#00000000"
        android:startColor="#FF000000" />
</shape>
