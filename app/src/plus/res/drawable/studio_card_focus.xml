<?xml version="1.0" encoding="utf-8"?>
<!-- Frame of a card: apricot ring with a light inner line when focused, a faint warm hairline otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="3dp"
                        android:color="@color/studio_apricot" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="#80FFF3EA" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#24FFE7D6" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
