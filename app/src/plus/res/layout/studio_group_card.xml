<?xml version="1.0" encoding="utf-8"?>
<!-- "See all" tile at the start of a start page row: pastel colour of the row, icon and name -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/studio_group_root"
    android:layout_width="206dp"
    android:layout_height="116dp"
    android:background="@drawable/studio_group_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/studio_group_focus">

    <ImageView
        android:id="@+id/studio_group_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/studio_group_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/studio_on_accent"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/studio_group_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/studio_show_all"
            android:textColor="@color/studio_on_accent_dim"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
