<?xml version="1.0" encoding="utf-8"?>
<!-- Photo info in the viewer: date and time top left, place bottom right, both on soft glass pills.
     Shown when a photo appears, fades out on its own (StudioInfoOverlayPlugin). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/studio_info_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0"
    android:clickable="false"
    android:elevation="10dp"
    android:focusable="false"
    android:importantForAccessibility="no">

    <LinearLayout
        android:id="@+id/studio_info_when"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="40dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/studio_glass_pill"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="13dp">

        <TextView
            android:id="@+id/studio_info_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/studio_text"
            android:textSize="22sp"
            tools:text="Sonntag, 13. Juli 2025" />

        <TextView
            android:id="@+id/studio_info_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/studio_apricot"
            android:textSize="17sp"
            android:drawableStart="@drawable/studio_ic_clock"
            tools:text="14:32 Uhr" />
    </LinearLayout>

    <TextView
        android:id="@+id/studio_info_place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/studio_glass_pill"
        android:drawablePadding="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:maxWidth="640dp"
        android:ellipsize="end"
        android:paddingStart="18dp"
        android:paddingTop="11dp"
        android:paddingEnd="22dp"
        android:paddingBottom="11dp"
        android:textColor="@color/studio_text"
        android:textSize="19sp"
        android:drawableStart="@drawable/studio_ic_place_small"
        tools:text="München, Deutschland" />
</FrameLayout>
