<?xml version="1.0" encoding="utf-8"?>
<!-- "Infos" panel of the photo viewer: everything known about the photo, on the right side.
     Opened with the info button, closed with it again or with Back (StudioInfoPanelPlugin). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:elevation="12dp"
    android:focusable="false"
    android:importantForAccessibility="no">

    <LinearLayout
        android:id="@+id/studio_details_panel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/studio_details_bg"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:drawableStart="@drawable/studio_ic_info_accent"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/studio_info_title"
            android:textColor="@color/studio_peach"
            android:textSize="21sp" />

        <LinearLayout
            android:id="@+id/studio_details_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
